{
  "name": "maplibre-gl-pie-charts",
  "version": "0.2.0",
  "description": "Add a WebGL pie or donut chart layer on a MapLibre GL JS or Mapbox GL JS map to compare share patterns across geographic units",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "files": [
    "dist",
    "src/index.d.ts"
  ],
  "types": "dist/index.d.ts",
  "typings": "dist/index.d.ts",
  "scripts": {
    "build": "rollup -c && node --input-type=module -e \"import {copyFileSync} from 'node:fs'; copyFileSync('src/index.d.ts', 'dist/index.d.ts')\"",
    "dev": "rollup -c -w",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mapbox",
    "mapbox-gl-js",
    "maplibre",
    "maplibre-gl-js",
    "custom-layer",
    "chart-layer",
    "web-map",
    "pie-chart",
    "donut",
    "geoparquet",
    "flatgeobuf",
    "geojson"
  ],
  "author": "Zifan Wang",
  "license": "MIT",
  "peerDependencies": {
    "flatgeobuf": "^4.6.1",
    "hyparquet": "^1.33.0",
    "hyparquet-compressors": "^1.1.3",
    "mapbox-gl": "^3.0.0",
    "maplibre-gl": "^4.0.0 || ^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "mapbox-gl": {
      "optional": true
    },
    "maplibre-gl": {
      "optional": true
    },
    "flatgeobuf": {
      "optional": true
    },
    "hyparquet": {
      "optional": true
    },
    "hyparquet-compressors": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-terser": "^0.4.4",
    "rollup": "^4.0.0"
  }
}
